<h1><%= @event.title %></h1>
<p><%= simple_format(@event.description) %></p>
<p><strong>保護者案内用URL:</strong> <code><%= public_event_url(@event.token) %></code></p>

<%= link_to "← 一覧に戻る", events_path %>

<% if notice %>
  <p style="color: green; font-weight: bold;"><%= notice %></p>
<% end %>

<hr>

<h2>1. 自動日程調整</h2>
<div style="margin-bottom: 20px;">
  <%= button_to "⚡ 自動で日程を確定する（クラス別・重複なし）", auto_schedule_event_path(@event), method: :post, data: { confirm: "各クラスごとに希望に基づき重複なしで確定します。よろしいですか？" }, style: "padding: 10px 20px; background-color: #28a745; color: white; border: none; font-size: 16px; cursor: pointer; border-radius: 5px;" %>
  
  <span style="margin-left: 10px;">
    <%= button_to "確定を全リセット", reset_schedule_event_path(@event), method: :post, data: { confirm: "すべての確定状態を解除しますか？" }, style: "padding: 5px 10px; background-color: #dc3545; color: white; border: none; border-radius: 3px;" %>
  </span>
</div>

<hr>

<h2>2. クラス別 懇談日程確定表</h2>

<%# 存在するクラス（1年1組、2年2組など）ごとにグループ分け %>
<% attendees_by_class = @attendees.group_by(&:grade_class) %>

<% if attendees_by_class.empty? %>
  <p>まだ回答した保護者はいません。</p>
<% else %>
  <% attendees_by_class.each do |grade_class, class_attendees| %>
    <div style="margin-bottom: 40px; border: 2px solid #007bff; padding: 15px; border-radius: 8px; background-color: #f8f9fa;">
      <h3 style="margin-top: 0; color: #007bff;">🏫 <%= grade_class.presence || "クラス未指定" %></h3>

      <table border="1" cellpadding="8" style="border-collapse: collapse; width: 100%; background-color: white;">
        <thead>
          <tr style="background-color: #e9ecef;">
            <th style="width: 25%;">日時枠</th>
            <th style="width: 35%;">確定した児童（保護者名）</th>
            <th style="width: 40%;">手動変更</th>
          </tr>
        </thead>
        <tbody>
          <% @candidates.each do |candidate| %>
            <%# このクラスの中で、この時間枠に決まっている保護者を探す %>
            <% confirmed_attendee = class_attendees.find { |a| a.confirmed_candidate_id == candidate.id } %>
            
            <tr style="<%= 'background-color: #e2f0d9;' if confirmed_attendee %>">
              <td>
                <strong><%= candidate.start_at.strftime("%Y/%m/%d %H:%M") %> 〜 <%= candidate.end_at.strftime("%H:%M") %></strong>
              </td>
              <td>
                <% if confirmed_attendee %>
                  <b style="font-size: 16px; color: #155724;"><%= confirmed_attendee.child_name %></b>
                  <span style="font-size: 13px; color: #555;">（<%= confirmed_attendee.parent_name %> 様）</span>
                <% else %>
                  <span style="color: #888;">［ 空き枠 ］</span>
                <% end %>
              </td>
              <td>
                <%= form_with url: confirm_attendee_event_path(@event), method: :patch, local: true, style: "display: inline-block;" do |f| %>
                  <%= select_tag :attendee_id,
                      options_from_collection_for_select(class_attendees, :id, :child_name, confirmed_attendee&.id),
                      include_blank: "-- 割り当てる児童を選択 --" %>
                  <%= hidden_field_tag :confirmed_candidate_id, candidate.id %>
                  <%= f.submit "変更" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>

<hr>

<h2>3. 保護者ごとの希望回答一覧（全体）</h2>
<table border="1" cellpadding="6" style="border-collapse: collapse; width: 100%;">
  <thead>
    <tr style="background-color: #f8f9fa;">
      <th>クラス</th>
      <th>児童名</th>
      <th>希望（◯/△/✕）</th>
      <th>現在の確定枠</th>
    </tr>
  </thead>
  <tbody>
    <% @attendees.each do |attendee| %>
      <tr>
        <td><b><%= attendee.grade_class %></b></td>
        <td><%= attendee.child_name %> （<%= attendee.parent_name %>）</td>
        <td>
          <% attendee.responses.each do |res| %>
            <small>
              <%= res.candidate.start_at.strftime("%m/%d %H:%M") %>:
              <b><%= res.status == 'ok' ? '◯' : (res.status == 'pending' ? '△' : '✕') %></b>
            </small> |
          <% end %>
        </td>
        <td>
          <% if attendee.confirmed_candidate %>
            <span style="color: green; font-weight: bold;">
              <%= attendee.confirmed_candidate.start_at.strftime("%m/%d %H:%M") %>
            </span>
          <% else %>
            <span style="color: red; font-weight: bold;">未割り当て（要調整）</span>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>